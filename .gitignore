*.jar
*.war
.gradle/
.mvn/
mvnw
mvnw.cmd
*.iml

# ===== 前端 Node 产物 =====
node_modules/
dist/
.vite/
.cache/
*.local

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== 日志 / 临时文件 =====
