logs/
*.tmp
*.bak

# ===== 系统 / 环境文件 =====
.env
.env.local
.env.*.local

# ===== 敏感信息 (数据库密码、token 等) =**
**/application-*.yml
!**/application.yml
!**/application-druid.yml
**/secrets.properties
**/*.pem
**/*.key
**/keystore/

# ===== 数据库文件 =====
*.db
*.sqlite
*.sqlite3

# ===== 编译缓存 =====
**/__pycache__/
**/.pytest_cache/

