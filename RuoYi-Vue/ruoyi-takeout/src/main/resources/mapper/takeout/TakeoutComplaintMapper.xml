<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutComplaintMapper">

    <resultMap type="TakeoutComplaint" id="TakeoutComplaintResult">
        <id     property="complaintId"     column="complaint_id"     />
        <result property="orderId"          column="order_id"          />
        <result property="userId"           column="user_id"           />
        <result property="merchantId"       column="merchant_id"       />
        <result property="riderId"          column="rider_id"          />
        <result property="type"             column="type"              />
        <result property="reason"           column="reason"            />
        <result property="images"           column="images"            />
        <result property="refundAmount"     column="refund_amount"     />
        <result property="approvedAmount"   column="approved_amount"   />
        <result property="status"           column="status"            />
        <result property="handleRemark"     column="handle_remark"    />
        <result property="handleBy"         column="handle_by"        />
        <result property="handleTime"       column="handle_time"       />
        <result property="refundTime"       column="refund_time"       />
        <result property="refundFlowNo"     column="refund_flow_no"    />
        <result property="appealContent"     column="appeal_content"    />
        <result property="appealTime"       column="appeal_time"       />
        <result property="appealStatus"     column="appeal_status"     />
        <result property="appealHandle"     column="appeal_handle"     />
        <result property="delFlag"          column="del_flag"          />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
        <result property="remark"           column="remark"            />
        <result property="orderNo"          column="order_no"          />
        <result property="userNickname"     column="user_nickname"     />
        <result property="merchantName"     column="merchant_name"     />
        <result property="riderName"        column="rider_name"        />
    </resultMap>

    <sql id="selectComplaintVo">
        select c.complaint_id, c.order_id, c.user_id, c.merchant_id, c.rider_id,
               c.type, c.reason, c.images, c.refund_amount, c.approved_amount,
               c.status, c.handle_remark, c.handle_by, c.handle_time,
               c.refund_time, c.refund_flow_no,
               c.appeal_content, c.appeal_time, c.appeal_status, c.appeal_handle,
               c.del_flag, c.create_by, c.create_time, c.update_by, c.update_time, c.remark,
               o.order_no,
               u.nickname as user_nickname,
               m.merchant_name,
               r.name as rider_name
        from takeout_complaint c
        left join takeout_order o on c.order_id = o.order_id
        left join takeout_user u on c.user_id = u.user_id and u.del_flag = '0'
        left join takeout_merchant m on c.merchant_id = m.merchant_id and m.del_flag = '0'
        left join takeout_rider r on c.rider_id = r.rider_id and r.del_flag = '0'
    </sql>

    <select id="selectComplaintList" parameterType="TakeoutComplaint" resultMap="TakeoutComplaintResult">
        <include refid="selectComplaintVo"/>
        <where>
            c.del_flag = '0'
            <if test="complaintId != null">AND c.complaint_id = #{complaintId}</if>
            <if test="orderId != null">AND c.order_id = #{orderId}</if>
            <if test="userId != null">AND c.user_id = #{userId}</if>
            <if test="merchantId != null">AND c.merchant_id = #{merchantId}</if>
            <if test="riderId != null">AND c.rider_id = #{riderId}</if>
            <if test="type != null and type != ''">AND c.type = #{type}</if>
            <if test="status != null and status != ''">AND c.status = #{status}</if>
        </where>
        order by c.complaint_id desc
    </select>

    <select id="selectComplaintById" parameterType="Long" resultMap="TakeoutComplaintResult">
        <include refid="selectComplaintVo"/>
        where c.del_flag = '0' and c.complaint_id = #{complaintId}
    </select>

    <insert id="insertComplaint" parameterType="TakeoutComplaint" useGeneratedKeys="true" keyProperty="complaintId">
        insert into takeout_complaint(
            <if test="complaintId != null">complaint_id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="merchantId != null">merchant_id,</if>
            <if test="riderId != null">rider_id,</if>
            <if test="type != null and type != ''">type,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="images != null">images,</if>
            <if test="refundAmount != null">refund_amount,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values(
            <if test="complaintId != null">#{complaintId},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="merchantId != null">#{merchantId},</if>
            <if test="riderId != null">#{riderId},</if>
            <if test="type != null and type != ''">#{type},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="images != null">#{images},</if>
            <if test="refundAmount != null">#{refundAmount},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateComplaint" parameterType="TakeoutComplaint">
        update takeout_complaint
        <set>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where complaint_id = #{complaintId} and del_flag = '0'
    </update>

    <delete id="deleteComplaintByIds" parameterType="Long">
        update takeout_complaint set del_flag = '2' where complaint_id in
        <foreach collection="array" item="complaintId" open="(" separator="," close=")">
            #{complaintId}
        </foreach>
    </delete>

    <update id="processComplaint" parameterType="TakeoutComplaint">
        update takeout_complaint
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="approvedAmount != null">approved_amount = #{approvedAmount},</if>
            <if test="handleRemark != null">handle_remark = #{handleRemark},</if>
            <if test="handleBy != null and handleBy != ''">handle_by = #{handleBy},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
            <if test="refundTime != null">refund_time = #{refundTime},</if>
            <if test="refundFlowNo != null">refund_flow_no = #{refundFlowNo},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where complaint_id = #{complaintId} and del_flag = '0'
    </update>

    <update id="updateAppeal" parameterType="TakeoutComplaint">
        update takeout_complaint
        <set>
            <if test="appealContent != null">appeal_content = #{appealContent},</if>
            <if test="appealTime != null">appeal_time = #{appealTime},</if>
            <if test="appealStatus != null and appealStatus != ''">appeal_status = #{appealStatus},</if>
            <if test="appealHandle != null">appeal_handle = #{appealHandle},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where complaint_id = #{complaintId} and del_flag = '0'
    </update>
</mapper>
