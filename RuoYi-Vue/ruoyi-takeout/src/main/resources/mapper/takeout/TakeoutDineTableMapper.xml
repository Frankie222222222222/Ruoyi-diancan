<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutDineTableMapper">

    <resultMap type="TakeoutDineTable" id="TakeoutDineTableResult">
        <id     property="tableId"     column="table_id"     />
        <result property="merchantId"  column="merchant_id"  />
        <result property="tableNo"     column="table_no"     />
        <result property="capacity"    column="capacity"     />
        <result property="status"      column="status"       />
        <result property="qrUrl"       column="qr_url"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectDineTableVo">
        SELECT t.table_id, t.merchant_id, t.table_no, t.capacity, t.status, t.qr_url,
               t.del_flag, t.create_by, t.create_time, t.update_by, t.update_time, t.remark
        FROM takeout_dine_table t
    </sql>

    <select id="selectDineTableList" parameterType="TakeoutDineTable" resultMap="TakeoutDineTableResult">
        <include refid="selectDineTableVo"/>
        <where>
            t.del_flag = '0'
            <if test="merchantId != null">AND t.merchant_id = #{merchantId}</if>
            <if test="tableNo != null and tableNo != ''">AND t.table_no LIKE CONCAT('%', #{tableNo}, '%')</if>
            <if test="status != null and status != ''">AND t.status = #{status}</if>
        </where>
        ORDER BY t.merchant_id ASC, t.table_id ASC
    </select>

    <select id="selectDineTableById" parameterType="Long" resultMap="TakeoutDineTableResult">
        <include refid="selectDineTableVo"/>
        WHERE t.del_flag = '0' AND t.table_id = #{tableId}
    </select>

    <select id="selectDineTableByNo" parameterType="TakeoutDineTable" resultMap="TakeoutDineTableResult">
        <include refid="selectDineTableVo"/>
        WHERE t.del_flag = '0'
          AND t.merchant_id = #{merchantId}
          AND t.table_no = #{tableNo}
        LIMIT 1
    </select>

    <insert id="insertDineTable" parameterType="TakeoutDineTable" useGeneratedKeys="true" keyProperty="tableId">
        INSERT INTO takeout_dine_table (
            <if test="merchantId != null">merchant_id,</if>
            <if test="tableNo != null and tableNo != ''">table_no,</if>
            <if test="capacity != null">capacity,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="qrUrl != null and qrUrl != ''">qr_url,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) VALUES (
            <if test="merchantId != null">#{merchantId},</if>
            <if test="tableNo != null and tableNo != ''">#{tableNo},</if>
            <if test="capacity != null">#{capacity},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="qrUrl != null and qrUrl != ''">#{qrUrl},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            NOW()
        )
    </insert>

    <update id="updateDineTable" parameterType="TakeoutDineTable">
        UPDATE takeout_dine_table
        <set>
            <if test="tableNo != null and tableNo != ''">table_no = #{tableNo},</if>
            <if test="capacity != null">capacity = #{capacity},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="qrUrl != null">qr_url = #{qrUrl},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE table_id = #{tableId} AND del_flag = '0'
    </update>

    <update id="updateDineTableStatus" parameterType="TakeoutDineTable">
        UPDATE takeout_dine_table
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = NOW()
        </set>
        WHERE table_id = #{tableId} AND del_flag = '0'
    </update>

    <update id="deleteDineTableByIds" parameterType="Long">
        UPDATE takeout_dine_table SET del_flag = '2', update_time = NOW()
        WHERE table_id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

    <select id="countIdleByMerchantId" parameterType="Long" resultType="int">
        SELECT COUNT(*) FROM takeout_dine_table
        WHERE del_flag = '0' AND merchant_id = #{merchantId} AND status = '0'
    </select>

    <!-- 堂食订单进行中: status ∈ {DRAFT(0a), PAID(1), MAKING(2a), READY(2b), DONE(5)}; CANCELLED/COMPLETED 不算 -->
    <select id="countActiveDineOrdersByTableId" parameterType="Long" resultType="int">
        SELECT COUNT(*) FROM takeout_order
        WHERE del_flag = '0'
          AND order_type = 1
          AND table_id = #{tableId}
          AND status IN ('0a','1','2a','2b')
    </select>

</mapper>
