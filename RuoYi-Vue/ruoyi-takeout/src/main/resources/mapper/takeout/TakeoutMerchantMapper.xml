<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutMerchantMapper">

    <resultMap type="TakeoutMerchant" id="TakeoutMerchantResult">
        <id     property="merchantId"      column="merchant_id"      />
        <result property="merchantName"    column="merchant_name"    />
        <result property="contactName"     column="contact_name"     />
        <result property="contactPhone"    column="contact_phone"    />
        <result property="address"         column="address"          />
        <result property="logo"            column="logo"             />
        <result property="businessLicense" column="business_license"/>
        <result property="status"          column="status"           />
        <result property="auditStatus"     column="audit_status"     />
        <result property="auditRemark"     column="audit_remark"     />
        <result property="userId"          column="user_id"          />
        <result property="delFlag"         column="del_flag"         />
        <result property="createBy"        column="create_by"        />
        <result property="createTime"      column="create_time"      />
        <result property="updateBy"        column="update_by"        />
        <result property="updateTime"      column="update_time"      />
        <result property="remark"          column="remark"           />
        <!-- ??????????????????????? insert/update?? -->
        <result property="bindUserName"    column="bind_user_name"   />
    </resultMap>

    <!-- ?��???? SQL??left join sys_user ???? -->
    <sql id="selectMerchantVo">
        select m.merchant_id, m.merchant_name, m.contact_name, m.contact_phone,
               m.address, m.logo, m.business_license,
               m.status, m.audit_status, m.audit_remark, m.user_id, m.del_flag,
               m.create_by, m.create_time, m.update_by, m.update_time, m.remark,
               u.user_name as bind_user_name
        from takeout_merchant m
        left join sys_user u on m.user_id = u.user_id and u.del_flag = '0'
    </sql>

    <select id="selectMerchantList" parameterType="TakeoutMerchant" resultMap="TakeoutMerchantResult">
        <include refid="selectMerchantVo"/>
        <where>
            m.del_flag = '0'
            <if test="merchantId != null">AND m.merchant_id = #{merchantId}</if>
            <if test="merchantName != null and merchantName != ''">
                AND m.merchant_name like concat('%', #{merchantName}, '%')
            </if>
            <if test="contactName != null and contactName != ''">
                AND m.contact_name like concat('%', #{contactName}, '%')
            </if>
            <if test="contactPhone != null and contactPhone != ''">
                AND m.contact_phone like concat('%', #{contactPhone}, '%')
            </if>
            <if test="status != null and status != ''">AND m.status = #{status}</if>
            <if test="auditStatus != null and auditStatus != ''">AND m.audit_status = #{auditStatus}</if>
            <if test="userId != null">AND m.user_id = #{userId}</if>
        </where>
        order by m.merchant_id desc
    </select>

    <select id="selectMerchantById" parameterType="Long" resultMap="TakeoutMerchantResult">
        <include refid="selectMerchantVo"/>
        where m.del_flag = '0' and m.merchant_id = #{merchantId}
    </select>

    <select id="selectMerchantByUserId" parameterType="Long" resultMap="TakeoutMerchantResult">
        <include refid="selectMerchantVo"/>
        where m.del_flag = '0' and m.user_id = #{userId}
        limit 1
    </select>

    <delete id="deleteMerchantByIds" parameterType="Long">
        update takeout_merchant set del_flag = '2' where merchant_id in
        <foreach collection="array" item="merchantId" open="(" separator="," close=")">
            #{merchantId}
        </foreach>
    </delete>

    <insert id="insertMerchant" parameterType="TakeoutMerchant" useGeneratedKeys="true" keyProperty="merchantId">
        insert into takeout_merchant(
            <if test="merchantId != null">merchant_id,</if>
            <if test="merchantName != null and merchantName != ''">merchant_name,</if>
            <if test="contactName != null and contactName != ''">contact_name,</if>
            <if test="contactPhone != null and contactPhone != ''">contact_phone,</if>
            <if test="address != null and address != ''">address,</if>
            <if test="logo != null and logo != ''">logo,</if>
            <if test="businessLicense != null and businessLicense != ''">business_license,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status,</if>
            <if test="auditRemark != null and auditRemark != ''">audit_remark,</if>
            <if test="userId != null">user_id,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="merchantId != null">#{merchantId},</if>
            <if test="merchantName != null and merchantName != ''">#{merchantName},</if>
            <if test="contactName != null and contactName != ''">#{contactName},</if>
            <if test="contactPhone != null and contactPhone != ''">#{contactPhone},</if>
            <if test="address != null and address != ''">#{address},</if>
            <if test="logo != null and logo != ''">#{logo},</if>
            <if test="businessLicense != null and businessLicense != ''">#{businessLicense},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="auditStatus != null and auditStatus != ''">#{auditStatus},</if>
            <if test="auditRemark != null and auditRemark != ''">#{auditRemark},</if>
            <if test="userId != null">#{userId},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateMerchant" parameterType="TakeoutMerchant">
        update takeout_merchant
        <set>
            <if test="merchantName != null and merchantName != ''">merchant_name = #{merchantName},</if>
            <if test="contactName != null">contact_name = #{contactName},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="logo != null">logo = #{logo},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="auditStatus != null and auditStatus != ''">audit_status = #{auditStatus},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            user_id = #{userId},
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where merchant_id = #{merchantId} and del_flag = '0'
    </update>

    <update id="updateMerchantStatus" parameterType="TakeoutMerchant">
        update takeout_merchant
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where merchant_id = #{merchantId} and del_flag = '0'
    </update>

    <update id="auditMerchant" parameterType="TakeoutMerchant">
        update takeout_merchant
        <set>
            <if test="auditStatus != null and auditStatus != ''">audit_status = #{auditStatus},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where merchant_id = #{merchantId} and del_flag = '0'
    </update>
</mapper>