<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutPaymentMapper">

    <resultMap type="TakeoutPayment" id="TakeoutPaymentResult">
        <id     property="id"            column="id"            />
        <result property="orderId"       column="order_id"      />
        <result property="orderNo"       column="order_no"      />
        <result property="channel"       column="channel"       />
        <result property="outTradeNo"    column="out_trade_no"  />
        <result property="tradeNo"       column="trade_no"      />
        <result property="amount"        column="amount"        />
        <result property="status"        column="status"        />
        <result property="notifyRaw"     column="notify_raw"    />
        <result property="createBy"      column="create_by"     />
        <result property="createTime"    column="create_time"   />
        <result property="updateBy"      column="update_by"     />
        <result property="updateTime"    column="update_time"   />
        <result property="remark"        column="remark"        />
    </resultMap>

    <sql id="selectPaymentVo">
        select id, order_id, order_no, channel, out_trade_no, trade_no, amount, status, notify_raw,
               create_by, create_time, update_by, update_time, remark
        from takeout_payment
    </sql>

    <select id="selectPaymentList" parameterType="TakeoutPayment" resultMap="TakeoutPaymentResult">
        <include refid="selectPaymentVo"/>
        <where>
            <if test="orderId != null">AND order_id = #{orderId}</if>
            <if test="channel != null and channel != ''">AND channel = #{channel}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="outTradeNo != null and outTradeNo != ''">AND out_trade_no = #{outTradeNo}</if>
        </where>
        order by id desc
    </select>

    <select id="selectPaymentById" parameterType="Long" resultMap="TakeoutPaymentResult">
        <include refid="selectPaymentVo"/>
        where id = #{id}
    </select>

    <select id="selectByOutTradeNo" parameterType="String" resultMap="TakeoutPaymentResult">
        <include refid="selectPaymentVo"/>
        where out_trade_no = #{outTradeNo}
    </select>

    <insert id="insertPayment" parameterType="TakeoutPayment" useGeneratedKeys="true" keyProperty="id">
        insert into takeout_payment(
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null and orderNo != ''">order_no,</if>
            <if test="channel != null and channel != ''">channel,</if>
            <if test="outTradeNo != null and outTradeNo != ''">out_trade_no,</if>
            <if test="amount != null">amount,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values(
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null and orderNo != ''">#{orderNo},</if>
            <if test="channel != null and channel != ''">#{channel},</if>
            <if test="outTradeNo != null and outTradeNo != ''">#{outTradeNo},</if>
            <if test="amount != null">#{amount},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updatePayment" parameterType="TakeoutPayment">
        update takeout_payment
        <set>
            <if test="tradeNo != null and tradeNo != ''">trade_no = #{tradeNo},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="notifyRaw != null">notify_raw = #{notifyRaw},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>
</mapper>
