<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.takeout.mapper.TakeoutUserMapper">

    <resultMap type="TakeoutUser" id="TakeoutUserResult">
        <id     property="userId"        column="user_id"         />
        <result property="nickname"      column="nickname"       />
        <result property="phone"         column="phone"          />
        <result property="avatar"        column="avatar"         />
        <result property="gender"        column="gender"         />
        <result property="city"          column="city"           />
        <result property="totalOrders"   column="total_orders"   />
        <result property="totalSpend"    column="total_spend"    />
        <result property="regTime"       column="reg_time"       />
        <result property="lastLoginTime" column="last_login_time"/>
        <result property="status"        column="status"         />
        <result property="delFlag"       column="del_flag"       />
        <!-- v2 -->
        <result property="role"          column="role"           />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectUserVo">
        select user_id, nickname, phone, avatar, gender, city,
               total_orders, total_spend, reg_time, last_login_time,
               status, del_flag, role,
               create_by, create_time, update_by, update_time, remark
        from takeout_user
    </sql>

    <select id="selectUserList" parameterType="TakeoutUser" resultMap="TakeoutUserResult">
        <include refid="selectUserVo"/>
        <where>
            del_flag = '0'
            <if test="userId != null">AND user_id = #{userId}</if>
            <if test="nickname != null and nickname != ''">
                AND nickname like concat('%', #{nickname}, '%')
            </if>
            <if test="phone != null and phone != ''">
                AND phone like concat('%', #{phone}, '%')
            </if>
            <if test="status != null and status != ''">AND status = #{status}</if>
            <if test="role != null and role != ''">AND role = #{role}</if>
        </where>
        order by user_id desc
    </select>

    <select id="selectUserById" parameterType="Long" resultMap="TakeoutUserResult">
        <include refid="selectUserVo"/>
        where del_flag = '0' and user_id = #{userId}
    </select>

    <select id="selectUserByPhone" parameterType="String" resultMap="TakeoutUserResult">
        <include refid="selectUserVo"/>
        where del_flag = '0' and phone = #{phone} limit 1
    </select>

    <insert id="insertUser" parameterType="TakeoutUser" useGeneratedKeys="true" keyProperty="userId">
        insert into takeout_user(
            <if test="userId != null">user_id,</if>
            <if test="nickname != null">nickname,</if>
            <if test="phone != null and phone != ''">phone,</if>
            <if test="avatar != null">avatar,</if>
            <if test="gender != null and gender != ''">gender,</if>
            <if test="city != null">city,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="role != null and role != ''">role,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        ) values(
            <if test="userId != null">#{userId},</if>
            <if test="nickname != null">#{nickname},</if>
            <if test="phone != null and phone != ''">#{phone},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="gender != null and gender != ''">#{gender},</if>
            <if test="city != null">#{city},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="role != null and role != ''">#{role},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <update id="updateUser" parameterType="TakeoutUser">
        update takeout_user
        <set>
            <if test="nickname != null">nickname = #{nickname},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="gender != null and gender != ''">gender = #{gender},</if>
            <if test="city != null">city = #{city},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="role != null and role != ''">role = #{role},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where user_id = #{userId} and del_flag = '0'
    </update>

    <delete id="deleteUserByIds" parameterType="Long">
        update takeout_user set del_flag = '2' where user_id in
        <foreach collection="array" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
    </delete>

    <update id="updateLastLoginTime" parameterType="TakeoutUser">
        update takeout_user set last_login_time = sysdate() where user_id = #{userId}
    </update>

    <update id="incrementUserStats" parameterType="TakeoutUser">
        update takeout_user
        set total_orders = total_orders + 1,
            total_spend = total_spend + #{totalSpend}
        where user_id = #{userId}
    </update>

    <!-- v2(2026-10-10):改用户角色 -->
    <update id="changeUserRole">
        update takeout_user
        set role = #{role},
            update_by = #{updateBy},
            update_time = sysdate()
        where user_id = #{userId} and del_flag = '0'
    </update>
</mapper>
